# Шаблон /opt/demos/n8n/.env. Настоящий .env создаёт scripts/deploy.sh на сервере
# (случайные ключи генерируются там же) и в git не попадает.

# --- секреты: генерируются на сервере ---
N8N_ENCRYPTION_KEY=
# соль для HMAC-хэша IP: в журнале хранится только хэш, не адрес
IP_HASH_SALT=
# заголовок X-Eval-Token с этим значением снимает лимиты в час (для прогонов evals),
# дневной лимит токенов не снимает
EVAL_BYPASS_TOKEN=

# --- LLM: любой OpenAI-совместимый API (POST {LLM_BASE_URL}/chat/completions) ---
# Ключ и адрес шлюза не хранятся здесь: на сервере они в общем файле ../llm.env
# (подключён в docker-compose.yml):
#   LLM_API_KEY=...
#   LLM_BASE_URL=https://<шлюз>/v1
#   LLM_MODEL_SMART=...   LLM_MODEL_FAST=...
# Их можно задать и в этом .env, он перекрывает ../llm.env. Но пустая строка «LLM_API_KEY=»
# здесь тоже перекроет ключ, поэтому эти строки в шаблоне закомментированы.
# Нет ключа, адреса или модели = mock-режим (заглушка по ключевым словам, mode=mock).
# модель; пусто = LLM_MODEL_SMART
LLM_MODEL=
# предел ответа модели (max_completion_tokens), 200..2000
LLM_MAX_TOKENS=600
# reasoning_effort для рассуждающих моделей (например minimal); пусто = не передавать
LLM_REASONING_EFFORT=
# true = принудительный mock даже при заданном ключе
TRIAGE_FORCE_MOCK=false

# --- cost guard: ограничитель расхода ---
# дневной лимит токенов на модель (вход + выход, все попытки), по Москве
DAILY_TOKEN_BUDGET=200000
# цена в рублях за 1 млн токенов, по тарифу провайдера. Пусто = доска и ответы показывают
# только токены. Цены в коде не зашиты: без тарифа рубли не считаются
PRICE_RUB_PER_1M_INPUT=
PRICE_RUB_PER_1M_OUTPUT=
RATE_LIMIT_PER_IP_HOUR=5
# общий лимит в час, отдельно для формы и для API
RATE_LIMIT_GLOBAL_HOUR=60
# какому заголовку верить как адресу клиента: direct (никакому, по умолчанию),
# x-real-ip (nginx перезаписывает его: proxy_set_header X-Real-IP $remote_addr),
# cf-connecting-ip (Cloudflare), xff-last (последний адрес X-Forwarded-For; так за
# Tailscale Funnel). Caddy, cloudflared и Tailscale пропускают X-Real-IP клиента как есть:
# с ними x-real-ip не ставить
TRUST_PROXY_HEADER=direct

# --- Telegram (нода в воркфлоу выключена; включает владелец) ---
TELEGRAM_CHAT_ID=

# --- адрес, который n8n подставляет в ссылки форм (form-waiting) ---
# по умолчанию под ssh-туннель: ssh -L 18102:127.0.0.1:18102 <сервер>
# с обратным прокси заменить на публичный адрес и задать N8N_PROXY_HOPS=1
WEBHOOK_URL=http://localhost:18102/
# N8N_PROXY_HOPS=1
